# ==============================================================================
# OPR Logistics — 환경변수 (PRD #0001 §4.11 F11)
# 실제 값은 .env.local 또는 Vercel envvar로 주입. 이 파일에는 절대 시크릿 금지.
# ==============================================================================

# -----------------------------------------------------------------------------
# Neon Postgres
# -----------------------------------------------------------------------------
# DATABASE_URL          = Pooled (Neon 대시보드의 "Connection pooling" ON)
#                          → 앱 런타임(서버리스 function)에서 사용
# DATABASE_URL_UNPOOLED = Direct (토글 OFF) — hostname에 '-pooler' 없음
#                          → drizzle-kit 마이그레이션에서 사용
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# -----------------------------------------------------------------------------
# Vercel Blob (RAW + 결과물 저장)
# Vercel Blob 스토어 연결 시 자동 주입됩니다.
# -----------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# -----------------------------------------------------------------------------
# Cron (PRD §4.10)
# /api/cron/cleanup 호출 시 Authorization: Bearer ${CRON_SECRET} 검증
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------------
CRON_SECRET="generate-with-node-crypto-randomBytes(32)"

# -----------------------------------------------------------------------------
# 이메일 OTP 로그인 (Gmail SMTP) (PRD §4.11 F11 / M7)
# -----------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="yourgmail@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"        # Gmail "앱 비밀번호" 16자리 (본 비밀번호 X)
SMTP_FROM="OPR Logistics <yourgmail@gmail.com>"
OTP_PEPPER="generate-another-node-crypto-randomBytes(32)"
SESSION_SECRET="generate-another-node-crypto-randomBytes(32)"

# 로그인 허용 이메일 화이트리스트 (쉼표 구분, 소문자)
ALLOWED_EMAILS="alice@gmail.com,bob@gmail.com"

# -----------------------------------------------------------------------------
# 선택 / 후속
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_ENV="development"
ALERT_WEBHOOK_URL=""
