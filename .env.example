# ==============================================================================
# OPR Logistics — 환경변수 (PRD #0001 §4.11 F11)
# 실제 값은 .env.local 또는 Vercel envvar로 주입. 이 파일에는 절대 시크릿 금지.
# ==============================================================================

# Neon Postgres 연결 URL (직접 연결, NOT pooled — Drizzle migration 용)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Neon Pool 연결 URL (앱 런타임용)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Vercel Blob (Production: Vercel가 자동 주입, 로컬은 vercel link 후 vercel env pull)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# Cron 비밀번호 (/api/cron/cleanup Authorization 헤더 검증용)
CRON_SECRET="generate-with: openssl rand -hex 32"

# M6 이메일 OTP (SendGrid)
SENDGRID_API_KEY=""
OTP_PEPPER="generate-with: openssl rand -hex 32"
OTP_EMAIL_FROM="noreply@example.com"

# 환경 식별 (development / preview / production)
NEXT_PUBLIC_APP_ENV="development"

# 알람 (cron 실패 / 보안 이벤트)
ALERT_WEBHOOK_URL=""
